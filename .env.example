# ==============================================================================
# AI Meeting Intelligence - Environment Variables Template
# Sao chép file này thành .env và điền các khóa API tương ứng của bạn
# ==============================================================================

# LLM API Keys (Tùy chọn mô hình sử dụng sau này)
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=

# Hugging Face Access Token (Nếu dùng các mô hình từ Hugging Face Hub)
HF_TOKEN=

# App Settings
APP_ENV=development

